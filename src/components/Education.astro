---
const timeline = [
  {
    period: "Egresada",
    title: "Tecnóloga en Desarrollo de Software",
    place: "Institución Universitaria Colegio Mayor del Cauca",
    text: "Base sólida en programación, bases de datos y desarrollo de software. Fortalezas en Python y SQL.",
  },
  {
    period: "En curso",
    title: "Ingeniería Informática",
    place: "Formación profesional en curso",
    text: "Profundización en ingeniería de software mientras oriento el perfil hacia Analytics y Ciencia de Datos.",
  },
  {
    period: "En formación activa",
    title: "Ciencia de Datos · Analytics",
    place: "EDA · Machine Learning · Deep Learning",
    text: "Análisis exploratorio, estadística y modelos: del dato disperso a patrones, oportunidades y decisiones.",
  },
];

const blandas = [
  "Pensamiento crítico",
  "Curiosidad por aprender",
  "Adaptación",
  "Atención al detalle",
  "Trabajo en equipo",
  "Liderazgo",
  "Comunicación clara",
];
---

<section id="formacion" aria-labelledby="edu-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
  <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#0f766e]">Formación</p>
  <h2 id="edu-title" class="mt-2 font-display text-3xl font-semibold text-[#2b1a23] sm:text-4xl">
    Camino hacia la Ciencia de Datos
  </h2>

  <ol class="mt-10 space-y-0">
    {
      timeline.map((t, i) => (
        <li class="relative flex gap-5 pb-8 last:pb-0">
          <div class="flex flex-col items-center" aria-hidden="true">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#881337] font-display text-sm font-bold text-white">
              {i + 1}
            </span>
            {i < timeline.length - 1 && <span class="mt-2 w-0.5 flex-1 rounded bg-[#f0ddd6]" />}
          </div>
          <article class="card-lift flex-1 rounded-2xl border border-[#f0ddd6] bg-white p-5 sm:p-6">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#0f766e]">{t.period}</p>
            <h3 class="mt-1 font-display text-lg font-semibold text-[#2b1a23] sm:text-xl">{t.title}</h3>
            <p class="text-sm font-medium text-[#881337]">{t.place}</p>
            <p class="mt-2 text-[15px] leading-relaxed text-[#57384a]">{t.text}</p>
          </article>
        </li>
      ))
    }
  </ol>

  <div class="mt-10 rounded-2xl bg-[#2b1a23] p-6 text-white sm:p-8">
    <h3 class="font-display text-xl font-semibold">Habilidades que sostienen el análisis</h3>
    <p class="mt-1 text-sm text-[#f3d9e1]">
      Tan importantes como el stack: así trabajo con equipos y con datos complejos.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Habilidades blandas">
      {
        blandas.map((b) => (
          <li class="rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-sm font-medium text-white">
            {b}
          </li>
        ))
      }
    </ul>
    <p class="mt-5 border-t border-white/15 pt-4 text-sm text-[#f3d9e1]">
      Siguiente paso: certificaciones en datos y posgrado en Analytics / Data Science —
      el perfil se fortalece proyecto a proyecto.
    </p>
  </div>
</section>
