---
import { Image } from "astro:assets";
import retrato from "../assets/gabi.jpeg";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import KaggleIcon from "./icons/KaggleIcon.astro";

// TODO: reemplazar LinkedIn/Kaggle por las URLs reales del perfil cuando se confirmen.
// Los enlaces actuales llevan a búsqueda/página general para no inventar un slug de perfil.
// Iconos GitHub/LinkedIn: SVG oficiales desde svgl.app. Kaggle no existe en svgl
// (verificado) y usa un icono provisional local.
const socials = [
  {
    label: "GitHub de Gabriela Orozco Vásquez",
    href: "https://github.com/gabi-vasquez",
    short: "GitHub",
    Icon: GitHubIcon,
  },
  {
    label: "LinkedIn — buscar a Gabriela Orozco Vásquez (perfil por confirmar)",
    href: "https://www.linkedin.com/search/results/all/?keywords=Gabriela%20Orozco%20V%C3%A1squez",
    short: "LinkedIn",
    Icon: LinkedInIcon,
  },
  {
    label: "Kaggle — perfil en construcción, ver comunidad Kaggle",
    href: "https://www.kaggle.com/",
    short: "Kaggle",
    Icon: KaggleIcon,
  },
];
---

<section id="home" aria-labelledby="hero-title" class="relative overflow-hidden pt-16">
  <div aria-hidden="true" class="dot-grid pointer-events-none absolute inset-0 opacity-60 [mask-image:radial-gradient(70%_60%_at_50%_30%,black,transparent)]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-[-6rem] h-96 w-96 rounded-full bg-[#f9d5e0] blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-[-8rem] left-[-6rem] h-96 w-96 rounded-full bg-[#cde7e3] blur-3xl"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-10 sm:px-6 md:pt-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14 lg:pb-24">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-[#f0ddd6] bg-white px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-[#0f766e]">
        <span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#0f766e]"></span>
        Ciencia de Datos · Software
      </p>
      <h1 id="hero-title" class="mt-5 font-display text-4xl font-semibold leading-[1.08] text-[#2b1a23] sm:text-5xl lg:text-[3.4rem]">
        Gabriela Orozco Vásquez
        <span class="mt-3 block text-[0.55em] font-medium leading-snug text-[#881337]">
          Transformo datos en decisiones
        </span>
      </h1>
      <p class="mt-3 text-sm font-semibold uppercase tracking-[0.14em] text-[#57384a]">
        Tecnóloga en Desarrollo de Software · Futura Ingeniera Informática
      </p>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-[#57384a] sm:text-lg">
        Convierto datos dispersos en información útil: analizo, exploro e interpreto datos
        con Python y SQL para resolver problemas reales y apoyar decisiones con impacto medible.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full bg-[#881337] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[#881337]/20 transition-colors hover:bg-[#6b0f2c]"
        >
          Hablemos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 rounded-full border-2 border-[#881337] bg-white px-6 py-3 text-sm font-semibold text-[#881337] transition-colors hover:bg-[#fdf2f5]"
        >
          Ver proyectos
        </a>
      </div>

      <ul aria-label="Perfiles profesionales" class="mt-7 flex flex-wrap items-center gap-2.5">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                title={s.label}
                class="inline-flex items-center gap-2 rounded-full border border-[#f0ddd6] bg-white px-4 py-2 text-sm font-semibold text-[#2b1a23] transition-colors hover:border-[#881337] hover:text-[#881337]"
              >
                <s.Icon size={16} />
                {s.short}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div aria-hidden="true" class="absolute -inset-3 rounded-[2rem] bg-gradient-to-br from-[#881337]/15 via-[#f9d5e0] to-[#0f766e]/15"></div>
      <figure class="relative overflow-hidden rounded-[1.75rem] border-4 border-white bg-white shadow-2xl shadow-[#881337]/15">
        <Image
          src={retrato}
          alt="Retrato profesional de Gabriela Orozco Vásquez"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 85vw, (max-width: 1024px) 40vw, 420px"
          formats={["avif", "webp", "jpeg"]}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover"
        />
        <figcaption class="flex items-center justify-between gap-3 bg-white px-5 py-4">
          <span class="text-sm font-semibold text-[#2b1a23]">Problema → Datos → Método → Impacto</span>
          <span class="rounded-full bg-[#e6f4f2] px-3 py-1 text-xs font-bold text-[#115e59]">EDA · ML</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
