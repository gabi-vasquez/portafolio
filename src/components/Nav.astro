---
import GitHubIcon from "./icons/GitHubIcon.astro";

// Navegación fija single-page: home → sobre-mi → habilidades → proyectos → formacion → contacto
const links = [
  { href: "#home", label: "Inicio" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#habilidades", label: "Habilidades" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#formacion", label: "Formación" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[#f0ddd6] bg-[#fffbf7]/90 backdrop-blur-md">
  <nav aria-label="Navegación principal" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#home" class="flex items-center gap-2.5" aria-label="Gabriela Orozco Vásquez — inicio">
      <span
        aria-hidden="true"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-[#881337] font-display text-base font-bold text-white"
      >
        G
      </span>
      <span class="leading-tight">
        <span class="block font-display text-[15px] font-semibold text-[#2b1a23]">Gabriela Orozco</span>
        <span class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-[#0f766e]">Datos · Software</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-full px-3.5 py-2 text-sm font-medium text-[#57384a] transition-colors hover:bg-[#fdf2f5] hover:text-[#881337]"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <a
          href="https://github.com/gabi-vasquez"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-[#881337] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#6b0f2c]"
        >
          <GitHubIcon size={16} />
          GitHub
        </a>
      </li>
    </ul>

    <button
      id="menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-[#2b1a23] hover:bg-[#fdf2f5] lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú de navegación"
    >
      <svg id="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg id="icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </nav>

  <div id="menu-movil" class="hidden border-t border-[#f0ddd6] bg-[#fffbf7] lg:hidden">
    <ul class="space-y-1 px-4 py-4">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="mobile-link block rounded-lg px-3 py-2.5 text-[15px] font-medium text-[#2b1a23] hover:bg-[#fdf2f5] hover:text-[#881337]"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="https://github.com/gabi-vasquez"
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-lg bg-[#881337] px-3 py-2.5 text-center text-[15px] font-semibold text-white"
        >
          Ver GitHub
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("menu-movil");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  function toggleMenu(force) {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    const isHidden = menu.classList.contains("hidden");
    const show = typeof force === "boolean" ? force : isHidden;
    menu.classList.toggle("hidden", !show);
    iconOpen.classList.toggle("hidden", show);
    iconClose.classList.toggle("hidden", !show);
    btn.setAttribute("aria-expanded", String(show));
    btn.setAttribute("aria-label", show ? "Cerrar menú de navegación" : "Abrir menú de navegación");
  }

  btn?.addEventListener("click", () => toggleMenu());
  menu?.querySelectorAll(".mobile-link").forEach((a) => a.addEventListener("click", () => toggleMenu(false)));
</script>
