---
import GitHubIcon from "./icons/GitHubIcon.astro";

const projects = [
  {
    n: "01",
    featured: true,
    category: "Académico",
    title: "Gestión de proyectos de grado · UNIMAYOR",
    repo: "davidleonmayor/proyecto-grado-unimayor",
    problema: "La gestión de proyectos de grado era manual, dispersa y difícil de seguir.",
    rol: "Backend & Base de datos",
    stack: ["Next.js", "TypeScript", "Prisma", "MySQL", "Docker"],
    metric: "Equipo de 6 · Sistema académico completo",
    github: "https://github.com/davidleonmayor/proyecto-grado-unimayor",
    live: null as string | null,
  },
  {
    n: "02",
    featured: false,
    category: "Web · Producto",
    title: "MoneyUp — finanzas personales + landing",
    repo: "davidleonmayor/MoneyUp · gabi-vasquez/MoneyUpLanding",
    problema: "Sin hábito de ahorro ni visión clara de gastos, las finanzas se desordenan.",
    rol: "Project Leader · Frontend",
    stack: ["TypeScript", "Astro", "Tailwind CSS"],
    metric: "Doble entrega: app + landing · Liderazgo de equipo",
    github: "https://github.com/davidleonmayor/MoneyUp",
    github2: "https://github.com/gabi-vasquez/MoneyUpLanding",
    github2Label: "Ver landing en GitHub",
    live: null as string | null,
  },
  {
    n: "03",
    featured: false,
    category: "Web · Académico",
    title: "Biblioteca — catálogo y préstamos",
    repo: "gabi-vasquez/Biblioteca",
    problema: "Una biblioteca pequeña necesitaba catalogar y prestar libros sin sistema.",
    rol: "Autora",
    stack: ["PHP", "POO", "MySQL", "Bootstrap"],
    metric: "CRUD completo · Desarrollo 100% propio",
    github: "https://github.com/gabi-vasquez/Biblioteca",
    live: null as string | null,
  },
];
---

<section id="proyectos" aria-labelledby="projects-title" class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#0f766e]">Proyectos</p>
        <h2 id="projects-title" class="mt-2 font-display text-3xl font-semibold text-[#2b1a23] sm:text-4xl">
          Problema → datos → método → impacto
        </h2>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-[#57384a] sm:text-lg">
          Solo proyectos verificados en GitHub. Cada caso parte de un problema real
          y cierra con un alcance medible.
        </p>
      </div>
      <a
        href="https://github.com/gabi-vasquez?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border-2 border-[#2b1a23] px-5 py-2.5 text-sm font-semibold text-[#2b1a23] transition-colors hover:bg-[#2b1a23] hover:text-white"
      >
        Todo en GitHub
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        projects.map((p) => (
          <article
            class:list={[
              "card-lift flex flex-col rounded-2xl border bg-[#fffbf7] p-6 sm:p-7",
              p.featured ? "border-[#881337] ring-1 ring-[#881337]/30 lg:col-span-1" : "border-[#f0ddd6]",
            ]}
            aria-label={`Proyecto: ${p.title}`}
          >
            <div class="flex items-center justify-between gap-3">
              <span aria-hidden="true" class="font-display text-4xl font-semibold text-[#f0ddd6]">{p.n}</span>
              <span class:list={[
                "rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide",
                p.featured ? "bg-[#881337] text-white" : "bg-[#e6f4f2] text-[#115e59]",
              ]}>
                {p.featured ? `★ ${p.category}` : p.category}
              </span>
            </div>

            <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-[#2b1a23]">{p.title}</h3>
            <p class="mt-1 font-mono text-xs text-[#57384a]">{p.repo}</p>

            <p class="mt-3 text-[15px] leading-relaxed text-[#57384a]">
              <strong class="font-semibold text-[#2b1a23]">Problema:</strong> {p.problema}
            </p>
            <p class="mt-2 text-[15px] text-[#57384a]">
              <strong class="font-semibold text-[#2b1a23]">Rol de Gabriela:</strong> {p.rol}
            </p>

            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`Stack de ${p.title}`}>
              {p.stack.map((t) => (
                <li class="rounded-md bg-[#fdf2f5] px-2.5 py-1 text-xs font-semibold text-[#881337]">{t}</li>
              ))}
            </ul>

            <p class="mt-4 inline-flex w-fit items-center gap-2 rounded-lg bg-[#2b1a23] px-3 py-1.5 text-xs font-semibold text-white">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
              {p.metric}
            </p>

            <div class="mt-5 flex flex-wrap gap-2.5 border-t border-[#f0ddd6] pt-5">
              <a
                href={p.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-[#2b1a23] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#881337]"
              >
                <GitHubIcon size={15} />
                GitHub
              </a>
              {"github2" in p && (
                <a
                  href={(p as { github2: string }).github2}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-[#2b1a23] px-4 py-2 text-sm font-semibold text-[#2b1a23] transition-colors hover:bg-[#2b1a23] hover:text-white"
                >
                  {(p as { github2Label: string }).github2Label}
                </a>
              )}
            </div>
          </article>
        ))
      }

      {/* Slot reservado: próximo caso de datos. Sin sección Data hasta tener repos reales. */}
      <article
        aria-label="Próximo caso de datos: análisis exploratorio, próximamente"
        class="flex flex-col justify-between rounded-2xl border-2 border-dashed border-[#0f766e]/50 bg-[#e6f4f2]/40 p-6 sm:p-7"
      >
        <div>
          <span aria-hidden="true" class="font-display text-4xl font-semibold text-[#0f766e]/30">04</span>
          <h3 class="mt-3 font-display text-xl font-semibold text-[#115e59]">Próximo caso de datos · EDA</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-[#115e59]">
            Este espacio está reservado para mi primer caso público de análisis exploratorio:
            pregunta, dataset, método e impacto medible.
          </p>
        </div>
        <a
          href="https://github.com/gabi-vasquez?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-[#0f766e] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#115e59]"
        >
          Seguir el avance en GitHub
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </article>
    </div>

    <p class="mt-6 text-sm text-[#57384a]">
      Nota de verificación: solo se publican repositorios accesibles. Los nombres no verificados
      (juegos, demos sin repo público) quedan <em>por confirmar</em> y no se renderizan.
    </p>
  </div>
</section>
